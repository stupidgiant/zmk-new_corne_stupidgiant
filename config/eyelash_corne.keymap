#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

// Binding that starts layer-light calibration.
#define LYL_CALIBRATE 0 0xF0000000

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

/ {
    behaviors {
        // Layer lights: while one of these layers is active, the LEDs under
        // the keys that do something on it light up in its color. Layers are
        // counted from 0 in the order they appear below. Code: src/layer_lights.c
        lyl: lyl {
            compatible = "zmk,behavior-layer-lights";
            #binding-cells = <2>;
            layers = <1 2 3 5>;                            // NUMBER SYMBOL FN WM
            colors = <0xff7a33 0x5b47d6 0x8bd450 0xff2bd6>; // orange purple green pink
            calibration-layer = <6>;
        };

        // Top-left key on the FN layer: tap for Studio unlock, hold it for a
        // full 1.5 seconds to start layer-light calibration.
        cal_hold: cal_hold {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <1500>;
            bindings = <&lyl_cal>, <&studio_unlock>;
        };

        // Left thumb layer keys (Win/NUMBER and Space/FN). "balanced" means: if
        // you press and release another key while the thumb is down, it counts
        // as holding the layer, however quick you are. The stock &lt waited a
        // full 200 ms, so fast shortcuts came out as a Win or Space tap.
        // require-prior-idle-ms keeps fast typing safe: right after another
        // key, the thumb always taps. quick-tap-ms lets you tap then hold to
        // repeat a space.
        lt_thumb: lt_thumb {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <125>;
            bindings = <&mo>, <&kp>;
        };

        // Win/NUMBER thumb: counts as holding the layer the moment any other
        // key goes down, however fast and in whatever order you let go, so
        // muscle-memory shortcuts like -90 never send a stray Win. Tapped on
        // its own it is still Win.
        lt_win: lt_win {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&kp>;
        };

        T_Y: td0 {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Shift/Caps Lock Tap Dance";
            #binding-cells = <0>;
            bindings = <&kp T>, <&kp Y>;
        };

        tab_esc: tab_esc {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Shift/Caps Lock Tap Dance";
            #binding-cells = <0>;
            bindings = <&kp TAB>, <&kp ESCAPE>;

            label = "TAB_ESC";
        };

        lazy_stickykey: lazy_stickykey {
            compatible = "zmk,behavior-sticky-key";
            label = "LAZY_STICKYKEY";
            bindings = <&kp>;
            #binding-cells = <1>;
            lazy;
            release-after-ms = <100>;
        };
    };

    rgb_encoder: rgb_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&rgb_ug RGB_BRI>, <&rgb_ug RGB_BRD>;
    };

    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    combos {
        compatible = "zmk,combos";

        Backspace {
            bindings = <&kp BACKSPACE>;
            key-positions = <4 5 44>;
        };

        Search {
            bindings = <&kp F3>;
            key-positions = <17 18 44>;
        };

        assetbrowserclear {
            bindings = <&assetbrowser_clear>;
            key-positions = <32 33 44>;
        };

        gaming {
            bindings = <&tog 4>;
            key-positions = <4 5 7 8>;
        };

        winkey {
            bindings = <&kp LEFT_WIN>;
            key-positions = <32 44 43>;
        };

        tabcombo {
            bindings = <&kp LA(TAB)>;
            key-positions = <29 30>;
        };

        // Ctrl+Alt+Delete: Ctrl and Alt are no longer part of this combo, because
        // keys in a combo get held back for a moment, which made Ctrl and Alt
        // shortcuts finicky. Press Tab, Q and Backspace together instead, or
        // hold Ctrl and Alt and press the Del thumb key on the right.
        taskmanager {
            bindings = <&kp LC(LA(DELETE))>;
            key-positions = <0 1 12>;
        };
    };

    macros {
        lyl_cal: lyl_cal {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&lyl LYL_CALIBRATE>;
        };

        Ninty: Ninty {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp N9 &kp N0>;
            label = "NINTY";
        };

        ninty_minus: ninty_minus {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp MINUS &kp N9 &kp N0>;
            label = "NINTY_MINUS";
        };

        Mirror: Mirror {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(M)>;
            label = "MIRROR";
        };

        negative: negative {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp END &kp STAR &kp MINUS &kp N1 &kp ENTER>;
            label = "NEGATIVE";
        };

        assetbrowser_clear: assetbrowser_clear {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(F) &kp BACKSPACE>;
            label = "ASSETBROWSER_CLEAR";
        };

        winup: winup {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_WIN &kp UP_ARROW>, <&macro_pause_for_release>;

            label = "WINUP";
        };

        winleft: winleft {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_WIN &kp LEFT_ARROW>;
            label = "WINLEFT";
        };
    };

    // Holding the Win thumb key (layer 1) and the Space thumb key (layer 3)
    // together turns on the WM layer (layer 5).
    conditional_layers {
        compatible = "zmk,conditional-layers";

        wm_layer {
            if-layers = <1 3>;
            then-layer = <5>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";
            bindings = <
&tab_esc        &kp Q  &kp W  &kp E         &kp R        &kp T                                  &kp UP                &kp Y        &kp U  &kp I      &kp O    &kp P     &kp BSPC
&kp LEFT_SHIFT  &kp A  &kp S  &kp D         &kp F        &kp G                        &kp LEFT  &kp ENTER  &kp RIGHT  &kp H        &kp J  &kp K      &kp L    &kp SEMI  &kp SQT
&kp LCTRL       &kp Z  &kp X  &kp C         &kp V        &kp B        &kp LEFT_WIN              &kp DOWN              &kp N        &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp ENTER
                              &kp LEFT_ALT  &lt_win 1 LMETA  &lt_thumb 3 SPACE                                                  &lt 3 ENTER  &mo 2  &kp DEL
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        lower_layer {
            display-name = "NUMBER";
            bindings = <
&kp GRAVE  &kp N1        &kp N2  &kp N3        &ninty_minus  &Ninty                                 &kp C_RANDOM_PLAY              &kp HOME          &kp END         &kp UP_ARROW    &kp F21          &kp N0           &kp BSPC
&trans     &kp NUMBER_4  &kp N5  &kp NUMBER_6  &kp HOME      &kp N0                 &kp C_PREVIOUS  &kp C_PLAY_PAUSE   &kp C_NEXT  &kp LEFT_WIN      &kp LEFT        &kp DOWN_ARROW  &kp RIGHT        &rgb_ug RGB_EFF  &none
&trans     &kp N7        &kp N8  &kp N9        &negative     &Mirror  &kp C_MUTE                    &kp K_MUTE                     &kp C_PLAY_PAUSE  &kp K_PREVIOUS  &kp K_NEXT      &rgb_ug RGB_TOG  &none            &kp DEL
                                 &trans        &trans        &trans                                                                &kp INS           &kp DEL         &trans
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        raise_layer {
            display-name = "SYMBOL";
            bindings = <
&trans  &kp EXCL      &kp AT        &kp HASH   &kp DLLR   &kp PRCNT                            &mmv MOVE_UP                     &kp CARET  &kp AMPS   &kp ASTRK  &kp LPAR  &kp RPAR  &kp BSPC
&trans  &none         &mkp LCLK     &mkp MCLK  &mkp RCLK  &mkp MB4             &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &kp MINUS  &kp EQUAL  &kp LBKT   &kp RBKT  &kp BSLH  &kp GRAVE
&trans  &out OUT_USB  &out OUT_BLE  &none      &none      &mkp MB5   &trans                    &mmv MOVE_DOWN                   &kp UNDER  &kp PLUS   &kp LBRC   &kp RBRC  &kp PIPE  &kp TILDE
                                    &trans     &trans     &kp SPACE                                                             &kp RET    &trans     &trans
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        layer_3 {
            display-name = "FN/NUMPAD";
            bindings = <
&cal_hold 0 0      &kp F15  &kp F16  &kp F17  &kp F11  &kp F12                                    &kp LG(UP_ARROW)                               &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp SLASH  &kp ASTERISK    &trans
&trans          &kp F6   &kp F7   &kp F8   &kp F9   &kp F10                &kp LG(LEFT_ARROW)  &lazy_stickykey LEFT_WIN  &kp LG(RIGHT_ARROW)  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp MINUS  &kp KP_NUMLOCK  &trans
&trans          &kp F1   &kp F2   &kp F3   &kp F4   &kp F5   &kp C_MUTE                        &kp LG(DOWN_ARROW)                             &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp PLUS   &kp SCROLLLOCK  &trans
                                  &trans   &trans   &trans                                                                                    &trans           &kp KP_NUMBER_0  &kp PERIOD
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        Gaming {
            bindings = <
&kp ESCAPE  &kp Q  &kp W  &kp E     &kp R  &kp T                             &kp UP               &kp Y    &kp U   &kp I      &kp O    &kp P     &kp BSPC
&kp LSHFT   &kp A  &kp S  &kp D     &kp F  &kp G                   &kp LEFT  &kp RET   &kp RIGHT  &kp H    &kp J   &kp K      &kp L    &kp SEMI  &kp SQT
&kp LCTRL   &kp Z  &kp X  &kp C     &kp V  &kp B      &kp SPACE              &kp DOWN             &kp N    &kp M   &kp COMMA  &kp DOT  &kp FSLH  &kp RET
                          &kp LALT  &mo 1  &kp SPACE                                              &kp RET  &trans  &kp DEL
            >;
        };

        // Window manager layer for GlazeWM. Hold both left thumb keys (Win and
        // Space) to reach it; see conditional_layers above. It sends the
        // Ctrl+Alt+F13-F24 style shortcuts that the GlazeWM config listens for.
        // Hold Shift as well to send the focused window instead of just going.
        //   Tab        workspace 9
        //   Q W E R T  workspaces 1 4 2 3 8
        //   A S D      workspaces 5 6 7
        //   F G        focus the left / right monitor
        //   V B        send the window to the left / right monitor
        //   Z X C      tiling direction, float, fullscreen
        //   key after B  close the window
        layer_5 {
            display-name = "WM";
            bindings = <
&kp LC(LG(F13))  &kp LC(LA(F13))  &kp LC(LA(F14))  &kp LC(LA(F15))  &kp LC(LA(F16))  &kp LC(LA(F17))                             &trans          &trans  &trans  &trans  &trans  &trans  &trans
&trans           &kp LC(LA(F18))  &kp LC(LA(F19))  &kp LC(LA(F20))  &kp LC(LA(F21))  &kp LC(LA(F22))                     &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans           &kp LC(LS(F13))  &kp LC(LS(F14))  &kp LC(LS(F15))  &kp LC(LA(F23))  &kp LC(LA(F24))  &kp LC(LS(F16))            &trans          &trans  &trans  &trans  &trans  &trans  &trans
                                                   &trans           &trans           &trans                                                      &trans  &trans  &trans
            >;
        };
        // Parked here while the layer lights are being calibrated, so that
        // pressing every key types nothing. Leave all keys as &none.
        layer_6 {
            display-name = "CAL";
            bindings = <
&none  &none  &none  &none  &none  &none                 &none         &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none          &none  &none  &none  &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none  &none          &none         &none  &none  &none  &none  &none  &none
                     &none  &none  &none                               &none  &none  &none
            >;
        };
    };
};
